# --- soviet-simulator ---
.claude/*
# The agent roster and what those agents learn are project knowledge, not machine
# state: they are the only record of why a specialist works the way it does.
!.claude/agents/
!.claude/agent-memory/
!.claude/skills/
# Hooks are repo wiring, not machine state: CLAUDE.md tells every agent the
# knowledge graph "auto-updates on file changes (via hooks)", and that promise
# is only true if the hooks ship with the repo. settings.local.json stays
# ignored -- it holds per-machine permissions.
!.claude/settings.json
CLAUDE.local.md
/screenshots
/saves
task_plan.md
findings.md
progress.md

# Claude Code dumps local-command transcripts at the repo root
*-local-command-*.txt

# unrelated vendored clone, not part of this workspace
/vectiler

# --- inherited from Egregoria ---
.idea/*
.idea
logs
/target
# dir-only: the old `target*` glob also swallowed docs/.../target-scenarios.json
target/
**/*.rs.bk
*.ini
world/*
world
*.bc
*.exe
*.tar.gz
__pycache__
# br doctor per-run artifacts
.doctor/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

/book/
# Added by code-review-graph
.code-review-graph/
